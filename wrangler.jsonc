// Custom domains mauiyouthsports.com and www are served from the assets binding.
// Requests on any *.workers.dev host are redirected to the same path on the apex site.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maui-youth-sports",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {"pattern": "mauiyouthsports.com", "custom_domain": true},
    {"pattern": "www.mauiyouthsports.com", "custom_domain": true}
  ],
  // Required by the PR build command `npx wrangler preview`. Assets stay at the top level.
  "previews": {}
}
