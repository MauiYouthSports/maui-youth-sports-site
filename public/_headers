# Workers static assets apply these rules. The first match is the default;
# later rules override it. HTML stays at max-age=0. Immutable caching is
# only for versioned filenames and the query-versioned scripts.
/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=86400

/assets/js/*
  Cache-Control: public, max-age=86400

/assets/data/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/home-scores.js
  Cache-Control: public, max-age=31536000, immutable

/assets/js/scores-source.js
  Cache-Control: public, max-age=31536000, immutable

/assets/js/scores-v39.js
  Cache-Control: public, max-age=31536000, immutable

/assets/js/submit.js
  Cache-Control: public, max-age=31536000, immutable

/assets/js/formspree.js
  Cache-Control: public, max-age=31536000, immutable

/assets/hero/homepage-banner-v24.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/hero/homepage-banner-v24-800.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/hero/homepage-banner-v24.png
  Cache-Control: public, max-age=31536000, immutable

/assets/hero/homepage-banner-v23.png
  Cache-Control: public, max-age=31536000, immutable

/assets/hero/homepage-hero-v1.png
  Cache-Control: public, max-age=31536000, immutable

/assets/hero/baseball-hero-v1.png
  Cache-Control: public, max-age=31536000, immutable

/assets/hero/football-hero-v1.png
